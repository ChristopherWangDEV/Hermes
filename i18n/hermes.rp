  "entries": [
    {
      "key": "\n  It stopped — right after paying for step %d, not after reconciling a bill.\n",
      "source": "\n  It stopped — right after paying for step %d, not after reconciling a bill.\n",
      "translations": {
        "zh-Hans": "\n  结果：停下了。而且是在**花掉第 %d 步的钱之后**立刻停的，不是跑完再对账。\n"
      },
      "state": "draft"
    },
    {
      "key": "   %d spans, %d failed\n",
      "source": "   %d spans, %d failed\n",
      "translations": {
        "zh-Hans": "   %d 个 span，失败 %d 个\n"
      },
      "state": "draft"
    },
    {
      "key": "   (skipped: needs clang; `hermes doctor` explains)",
      "source": "   (skipped: needs clang; `hermes doctor` explains)",
      "translations": {
        "zh-Hans": "   （跳过：需要 clang，`hermes doctor` 会说明）"
      },
      "state": "draft"
    },
    {
      "key": "   input  %s\n",
      "source": "   input  %s\n",
      "translations": {
        "zh-Hans": "   输入 %s\n"

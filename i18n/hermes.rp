  "entries": [
    {
      "key": "\n  It stopped — right after paying for step %d, not after reconciling a bill.\n",
      "source": "\n  It stopped — right after paying for step %d, not after reconciling a bill.\n",
      "translations": {
        "zh-Hans": "\n  结果：停下了。而且是在**花掉第 %d 步的钱之后**立刻停的，不是跑完再对账。\n"
      },
      "state": "draft"
    },
    {
      "key": "   %d spans, %d failed\n",
      "source": "   %d spans, %d failed\n",
      "translations": {
        "zh-Hans": "   %d 个 span，失败 %d 个\n"
      },
      "state": "draft"
    },
    {
      "key": "   (skipped: needs clang; `hermes doctor` explains)",
      "source": "   (skipped: needs clang; `hermes doctor` explains)",
      "translations": {
        "zh-Hans": "   （跳过：需要 clang，`hermes doctor` 会说明）"
      },
      "state": "draft"
    },
    {
      "key": "   input  %s\n",
      "source": "   input  %s\n",
      "translations": {
        "zh-Hans": "   输入 %s\n"
      },
      "state": "draft"
    },
    {
      "key": "   output %v\n",
      "source": "   output %v\n",
      "translations": {
        "zh-Hans": "   输出 %q\n"
      },
      "state": "draft"
    },
    {
      "key": "   workflow %q, %d nodes, upper bound max_steps=%d\n",
      "source": "   workflow %q, %d nodes, upper bound max_steps=%d\n",
      "translations": {
        "zh-Hans": "   workflow %q，%d 个节点，上界 max_steps=%d\n"
      },
      "state": "draft"
    },
    {
      "key": "  %d model calls, %d tool calls — all within the bound\n",
      "source": "  %d model calls, %d tool calls — all within the bound\n",
      "translations": {
        "zh-Hans": "  模型调用 %d 次，工具调用 %d 次，全部落在上界内\n"
      },
      "state": "draft"
    },
    {
      "key": "  Every turn the model asks for the same tool: it thinks it is making progress,",
      "source": "  Every turn the model asks for the same tool: it thinks it is making progress,",
      "translations": {
        "zh-Hans": "  模型每一轮都要求调用同一个工具：它以为在推进，其实在原地打转。"
      },
      "state": "draft"
    },
    {
      "key": "  FAILED: it did not stop at the bound\n",
      "source": "  FAILED: it did not stop at the bound\n",
      "translations": {
        "zh-Hans": "  实验失败：没有在上界处停下\n"
      },
      "state": "draft"
    },
    {
      "key": " (a compile-time constant, not a setting)",

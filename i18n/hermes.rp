      "state": "draft"
    },
    {
      "key": "   workflow %q, %d nodes, upper bound max_steps=%d\n",
      "source": "   workflow %q, %d nodes, upper bound max_steps=%d\n",
      "translations": {
        "zh-Hans": "   workflow %q，%d 个节点，上界 max_steps=%d\n"
      },
      "state": "draft"
    },
    {
      "key": "  %d model calls, %d tool calls — all within the bound\n",
      "source": "  %d model calls, %d tool calls — all within the bound\n",
      "translations": {
        "zh-Hans": "  模型调用 %d 次，工具调用 %d 次，全部落在上界内\n"
      },
      "state": "draft"
    },
    {
      "key": "  Every turn the model asks for the same tool: it thinks it is making progress,",
      "source": "  Every turn the model asks for the same tool: it thinks it is making progress,",
      "translations": {
        "zh-Hans": "  模型每一轮都要求调用同一个工具：它以为在推进，其实在原地打转。"
      },
      "state": "draft"
    },
    {
      "key": "  FAILED: it did not stop at the bound\n",
      "source": "  FAILED: it did not stop at the bound\n",
      "translations": {
        "zh-Hans": "  实验失败：没有在上界处停下\n"
      },
      "state": "draft"
    },
    {
      "key": "  a release package should ship LICENSE / NOTICE / THIRD_PARTY_NOTICES.md / licenses/.",
      "source": "  a release package should ship LICENSE / NOTICE / THIRD_PARTY_NOTICES.md / licenses/.",
      "translations": {
        "zh-Hans": "  发布包应当自带 LICENSE / NOTICE / THIRD_PARTY_NOTICES.md / licenses/。"
